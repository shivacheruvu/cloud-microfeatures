{
  "engine": "in-memory Data Classification API with the documented rules (local) / Data Classification API v1 on a scratch catalog (cloud)",
  "steps": [
    {
      "step": "read before any change",
      "call": "GET",
      "outcome": "absent",
      "scope_after": null
    },
    {
      "step": "apply v1",
      "call": "POST",
      "outcome": "ok",
      "scope_after": {
        "included_schemas": [
          "loyalty",
          "pos"
        ]
      }
    },
    {
      "step": "create v1 again",
      "call": "POST",
      "outcome": "rejected (exists)",
      "scope_after": {
        "included_schemas": [
          "loyalty",
          "pos"
        ]
      }
    },
    {
      "step": "apply v1 again",
      "call": "none",
      "outcome": "ok",
      "scope_after": {
        "included_schemas": [
          "loyalty",
          "pos"
        ]
      }
    },
    {
      "step": "apply v2",
      "call": "PATCH update_mask=included_schemas",
      "outcome": "ok",
      "scope_after": {
        "included_schemas": [
          "ecommerce",
          "loyalty",
          "pos"
        ]
      }
    },
    {
      "step": "apply v3",
      "call": "PATCH update_mask=included_schemas,excluded_schemas",
      "outcome": "ok",
      "scope_after": {
        "excluded_schemas": [
          "sandbox"
        ]
      }
    },
    {
      "step": "delete (disable classification)",
      "call": "DELETE",
      "outcome": "ok",
      "scope_after": null
    }
  ],
  "write_calls": 5,
  "noop_reapplies": 1,
  "versions": {
    "v1": {
      "why": "start with the two schemas that hold member data",
      "scope": {
        "included_schemas": [
          "loyalty",
          "pos"
        ]
      },
      "schemas_scanned": [
