# Copy to .env (git-ignored) and fill in YOUR OWN values. Never commit .env.
# Databricks (create a personal access token in your own workspace: Settings > Developer)
DATABRICKS_HOST="https://<your-workspace>.cloud.databricks.com"
DATABRICKS_TOKEN="<your-token>"

# Google Cloud (local runs use `gcloud auth application-default login`; no key files)
GCP_PROJECT_ID="<your-project-id>"
GCP_REGION="us-central1"
